# Copy to .env and fill in.

# REQUIRED. The same value as INTERNAL_API_KEY in OpenNVR's own .env:
# KAI-C uses it to call the adapter, the app uses it to register with core
# and to publish alerts.
INTERNAL_API_KEY=

# OpenNVR's compose project name: the prefix of its networks. Find it with
#   docker network ls
# and look for <project>_opennvr_internal. It is OpenNVR's checkout folder
# name (lowercased) unless OpenNVR was started with -p / COMPOSE_PROJECT_NAME.
OPENNVR_PROJECT=open-nvr

# Model settings — the values the fall transformer was validated with.
FALL_POSE_IMGSZ=640
FALL_POSE_CONF=0.25
FALL_THRESHOLD=0.90

# Test cameras (--profile testcam). The IP must sit inside OpenNVR's
# internal subnet (OPENNVR_DOCKER_SUBNET, default 172.28.0.0/16) and be free.
TESTCAM_IP=172.28.90.20
# Optional output fps cap for the test streams (empty = the video's own).
TESTCAM_FPS=
