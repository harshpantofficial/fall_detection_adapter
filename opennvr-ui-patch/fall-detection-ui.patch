@@ -0,0 +1,262 @@
+// Copyright (c) 2026 OpenNVR
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+// Falls: the fall-detection app's page.
+//
+// Three things, in the order an operator needs them: the camera live,
+// with the skeleton the model is watching and its verdict drawn on it
+// (the app's overlay — DetectionOverlay draws its keypoints); where each
+// camera stands right now (score, window, frame rate, what is wrong);
+// and the falls themselves, with the frame that raised each one.
+//
+// Everything here is read from what already exists: the app's /state
+// through core's status proxy, the alert inbox filtered to this app, and
+// the live overlay every app's boxes ride. No backend of its own.
+
+import { useMemo, useState } from 'react'
+import { useQuery } from '@tanstack/react-query'
+import { PersonStanding, RefreshCw } from 'lucide-react'
+import { apiService } from '../lib/apiService'
+import {
+  Badge, Button, Card, CardContent, CardHeader, CardTitle, EmptyState, PageHeader,
+  type BadgeVariant,
+} from '../components/ui'
+import { AlarmsTable } from '../components/alarms/AlarmsTable'
+import { useAckAlarms, useAlarmsList } from '../components/alarms/useAlarmsList'
+import type { RegisteredApp } from './AppCatalog'
+import { AppCamerasCard } from './apps/AppCamerasCard'
+import { AppQueryError } from './apps/AppQueryError'
+import { AppConfigureButton, AppPageHeader } from './apps/AppSetup'
+import { useAppCameras } from './apps/CameraPicker'
+import { LiveCameraPanel } from './guardscan/LiveCameraPanel'
+
+export const FALLS_CAPABILITY = 'falls'
+const SOURCE = 'fall-detection'
+const TITLE = 'Falls'
+const DESCRIPTION = 'Who fell, where, and the frame that showed it — with the skeleton the model is watching, live.'
+
+type CameraState = {
+  camera: string
+  fps: number
+  score: number | null
+  window: string
+  fallen: boolean
+  last_fall: string
+  error: string
+}
+type FallState = { falls_today?: number; cameras?: CameraState[]; recent?: string[] }
+type Camera = { id: number; name: string }
+
+export function findFallApp(apps: RegisteredApp[] | undefined): RegisteredApp | null {
+  return (
+    (apps ?? []).find(
+      (a) => a.enabled && ((a.manifest as any)?.provides ?? []).includes(FALLS_CAPABILITY),
+    ) ?? null
+  )
+}
+
+function idFromHandle(handle: string): number | null {
+  const m = /^cam-?(\d+)$/.exec(handle)
+  return m ? Number(m[1]) : null
+}
+
+/** The camera's verdict right now, as the overlay labels it. */
+function verdict(c: CameraState): { text: string; variant: BadgeVariant } {
+  if (c.error) return { text: 'Not watching', variant: 'warning' }
+  if (c.fallen) return { text: 'FALLEN', variant: 'critical' }
+  if (c.score == null) return { text: `Warming up ${c.window}`, variant: 'neutral' }
+  if (c.score >= 0.5) return { text: 'Fall risk', variant: 'warning' }
+  return { text: 'Upright', variant: 'success' }
+}
+
+export function FallDetection() {
+  const [liveChoice, setLiveChoice] = useState<number | null>(null)
+
+  const appsQuery = useQuery({
+    queryKey: ['apps'],
+    queryFn: async () => {
+      const { data } = await apiService.getApps()
+      return (Array.isArray(data) ? data : []) as RegisteredApp[]
+    },
+    retry: 0,
+  })
+  const app = findFallApp(appsQuery.data)
+
+  // Scores move with every frame; two seconds is as fresh as a person
+  // reading the page can use, and the picture itself is live.
+  const statusQuery = useQuery({
+    queryKey: ['app-status', app?.id],
+    queryFn: async () => {
+      const { data } = await apiService.getAppStatus(app!.id)
+      return data as { state?: FallState }
+    },
+    enabled: Boolean(app),
+    retry: 0,
+    refetchInterval: 2000,
+  })
+  const state: FallState = statusQuery.data?.state ?? {}
+
+  const camerasQuery = useQuery({
+    queryKey: ['cameras'],
+    queryFn: async () => {
+      const { data } = await apiService.getCameras()
+      const list = Array.isArray(data) ? data : (data as any)?.cameras
+      return (Array.isArray(list) ? list : []) as Camera[]
+    },
+    enabled: Boolean(app),
+    retry: 0,
+  })
+  const cameraName = (handle: string) => {
+    const id = idFromHandle(handle)
+    return camerasQuery.data?.find((c) => c.id === id)?.name ?? handle
+  }
+
+  // Live video only for cameras this app watches: another camera's
+  // picture would carry no skeleton and no verdict.
+  const picksQuery = useAppCameras(app?.id ?? '', Boolean(app) && app?.camera_picker !== false)
+  const picked = useMemo(
+    () => (picksQuery.data?.cameras ?? []).filter((c) => c.picked).map((c) => ({ id: c.id, name: c.name })),
+    [picksQuery.data],
+  )
+  // The camera to show: the one chosen, else one in alarm, else the first.
+  const fallenId = (state.cameras ?? []).filter((c) => c.fallen).map((c) => idFromHandle(c.camera))[0]
+  const liveId =
+    picked.some((c) => c.id === liveChoice) ? liveChoice
+      : picked.some((c) => c.id === fallenId) ? (fallenId as number)
+      : picked[0]?.id ?? null
+
+  const alarms = useAlarmsList({
+    queryKeyPrefix: 'fall-alarms', sourceName: SOURCE,
+    unacked: false, severity: null, page: 1, pageSize: 10, skip: 0,
+  })
+  const ack = useAckAlarms()
+  const alarmRows = alarms.rows.filter((a) => a.source_name === SOURCE)
+
+  if (appsQuery.isError) {
+    return (
+      <section className="space-y-4">
+        <PageHeader title={TITLE} description={DESCRIPTION} />
+        <AppQueryError kind="apps" error={appsQuery.error} onRetry={() => appsQuery.refetch()} />
+      </section>
+    )
+  }
+
+  if (!appsQuery.isPending && !app) {
+    return (
+      <section className="space-y-4">
+        <PageHeader title={TITLE} description={DESCRIPTION} />
+        <EmptyState
+          icon={<PersonStanding size={28} />}
+          title="Fall Detection is not installed"
+          description="Install and enable Fall Detection from the App Catalog. It needs the fall-detection adapter and its two model files — see examples/fall-detection/README.md."
+        />
+      </section>
+    )
