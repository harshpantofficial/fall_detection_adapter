+#: A COCO-17 skeleton is the only shape anything draws today; a cap keeps
+#: a malformed producer from shipping thousands of points per box.
+MAX_KEYPOINTS = 17
+
+
+def clean_keypoints(raw: Any) -> list[list[float]] | None:
+    """An app box's optional ``keypoints`` → ``[[x, y, conf], …]`` in 0..1.
+
+    Additive to ``overlay.boxes.v1`` (pose apps draw the skeleton they
+    reason about). Points must already be normalized like the box; a
+    point that is not three finite numbers is dropped rather than drawn
+    somewhere wrong, and coordinates are clamped to the frame. The slot
+    order is kept — index 9 stays the left wrist — so a dropped point
+    becomes a zero-confidence one, not a shift. ``None`` when there is
+    nothing usable."""
+    if not isinstance(raw, list) or not raw:
+        return None
+    out: list[list[float]] = []
+    usable = False
+    for point in raw[:MAX_KEYPOINTS]:
+        try:
+            x, y, c = (float(v) for v in point[:3])
+            if not all(v == v and abs(v) != float("inf") for v in (x, y, c)):
+                raise ValueError
+        except (TypeError, ValueError):
+            out.append([0.0, 0.0, 0.0])
+            continue
+        usable = True
+        clamp = lambda v: round(min(1.0, max(0.0, v)), 4)  # noqa: E731
+        out.append([clamp(x), clamp(y), clamp(c)])
+    return out if usable else None
+
