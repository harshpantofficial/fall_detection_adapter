+// COCO-17 bones, by keypoint index — the same list the pose adapter ships
+// as COCO_SKELETON. A joint below the floor is not drawn: a pose model
+// still returns occluded joints, at low confidence and in a guessed place.
+const SKELETON: [number, number][] = [
+  [15, 13], [13, 11], [16, 14], [14, 12], [11, 12], [5, 11], [6, 12],
+  [5, 6], [5, 7], [6, 8], [7, 9], [8, 10], [1, 2], [0, 1], [0, 2],
+  [1, 3], [2, 4], [3, 5], [4, 6],
+]
+const KEYPOINT_FLOOR = 0.3
+
+function drawSkeleton(
+  ctx: CanvasRenderingContext2D, kps: [number, number, number][],
+  W: number, H: number, lw: number, hue: number, alpha: number,
+) {
+  const seen = (i: number) => i < kps.length && kps[i][2] > KEYPOINT_FLOOR
+  ctx.lineWidth = Math.max(1, lw * 0.75)
+  ctx.strokeStyle = `hsla(${hue}, 85%, 65%, ${0.9 * alpha})`
+  ctx.beginPath()
+  for (const [a, b] of SKELETON) {
+    if (!seen(a) || !seen(b)) continue
+    ctx.moveTo(kps[a][0] * W, kps[a][1] * H)
+    ctx.lineTo(kps[b][0] * W, kps[b][1] * H)
+  }
+  ctx.stroke()
+  ctx.fillStyle = `rgba(255,255,255,${alpha})`
+  const r = Math.max(1.5, lw)
+  for (let i = 0; i < kps.length; i++) {
+    if (!seen(i)) continue
+    ctx.beginPath()
+    ctx.arc(kps[i][0] * W, kps[i][1] * H, r, 0, Math.PI * 2)
+    ctx.fill()
+  }
+}
